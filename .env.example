# Base URL backend (tanpa trailing slash). Dibaca oleh src/shared/lib/api.ts.
# Di Vercel: Project Settings → Environment Variables → set `URL`.
#
# Hanya variabel `URL` yang dibaca. `VITE_URL` diabaikan.
URL=https://api-taslim.duckdns.org

# Nilai yang terbukti bukan alamat API diabaikan (dengan peringatan di konsol
# browser) dan aplikasi jatuh ke https://api-taslim.duckdns.org, supaya login
# tidak mati total karena salah konfigurasi di dashboard:
#   - bukan URL absolut (mis. "/api")
#   - skema selain http/https
#   - host kode: github.com / gitlab.com / bitbucket.org
#
# Kasus nyata: variabel `URL` di dashboard Vercel pernah berisi alamat repo
# sehingga POST /auth/login dikirim ke github.com dan gagal sebagai error CORS.
